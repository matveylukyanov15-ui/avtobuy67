function breakdownCost(c,p){var value=Math.max(50000,c.marketPrice||c.buyPrice||100000);var factor=p.base||.02;var tierMult=c.tier==='super'?1.8:(c.tier==='premium'?1.35:1);return Math.max(3000,Math.round(value*factor*tierMult/1000)*1000)}
function runInspection(id){
  var c=null;for(var i=0;i<S.garage.length;i++)if(S.garage[i].id===id){c=S.garage[i];break}if(!c)return;
  ensureBreakdowns(c);if(c.inspected){toast('ℹ️ Диагностика уже проведена','green');return}
  var parts=breakdownParts(), count=1+Math.floor(Math.random()*3), chosen=[];
  while(chosen.length<count&&parts.length){var idx=Math.floor(Math.random()*parts.length);chosen.push(parts.splice(idx,1)[0])}
  c.breakdowns=chosen.map(function(p){return {key:p.key,name:p.name,icon:p.icon,cost:breakdownCost(c,p),fixed:false}});
  c.inspected=true;c.justBought=false;
  save();openApp('garage');toast('🔧 Диагностика завершена: '+(c.breakdowns.length?'найдены поломки':'поломок не найдено'),'green');
}
