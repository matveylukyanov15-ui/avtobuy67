function rSleep(){var n=S.time>=22||S.time<6;if(n)return '<div style="background:linear-gradient(180deg,#0a1229,#1a1f3a);color:#fff;padding:20px;text-align:center;min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center"><div style="font-size:4.5rem">🌙</div><div style="font-size:2.6rem;font-weight:800;margin:8px 0">'+tm()+'</div><div>День '+S.day+'</div><button style="background:linear-gradient(135deg,#4a7eff,#3060dd);color:#fff;border:none;padding:14px 30px;border-radius:40px;font-size:1rem;font-weight:700;margin-top:16px" onclick="sleepNow()">⏰ Спать</button></div>';return '<div style="background:linear-gradient(180deg,#87ceeb,#ffd89b);color:#333;padding:20px;text-align:center;min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center"><div style="font-size:4rem">☀️</div><div style="font-size:2.6rem;font-weight:800;margin:8px 0">'+tm()+'</div><div>День '+S.day+'</div><p style="margin:16px">Спать с 22:00</p><button style="background:#555;color:#fff;border:none;padding:14px 30px;border-radius:40px;font-size:1rem;font-weight:700" disabled>⏳ Ждать</button></div>'}
function sleepNow(){S.time=9;S.day++;checkDebt();if(S.alarm&&S.alarmDay>0&&S.day>S.alarmDay){S.alarm=0;S.alarmDay=0}if(S.meeting&&S.day>S.meeting.day){S.meeting=null}refill();save();upd();openApp('market')}
function checkDebt(){if(!S.debt||S.debt<=0)return;if(S.day>(S.debtDay||0)){S.debtOverdue=(S.debtOverdue||0)+1;var pen=Math.round(S.debt*0.05);S.debt+=pen;var autoPay=Math.min(S.money,S.debt);S.money-=autoPay;S.debt-=autoPay;if(S.debt<=0){S.debt=0;S.debtDay=0;S.debtOverdue=0;toast('💳 Долг закрыт','green')}else toast('⚠️ Просрочка +'+fmt(pen),'red');save();upd()}}

function rPromo(){var h='<div class="ic2" style="display:block;background:linear-gradient(135deg,#ff6b00,#ff0044);color:#fff;text-align:center;padding:20px"><h2>🎁 Промокоды</h2></div><input class="vin" id="promoIn" placeholder="Код"><button class="btn gr" onclick="activatePromo()">✨ Активировать</button>';return h}
