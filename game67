function rCasino(){var h='<div class="ic2" style="display:block;text-align:center;background:linear-gradient(135deg,#8b0000,#ff0044);color:#fff;padding:20px"><div style="font-size:2.5rem">🎰</div><h2>КАЗИНО</h2></div><div class="ic2">💰 Баланс: <b>'+fmt(S.money)+' ₽</b></div><button class="btn" style="background:linear-gradient(135deg,#ffb400,#ff8800);color:#111" onclick="playCasino(10000)">🎲 10 000 ₽</button><button class="btn" style="background:linear-gradient(135deg,#ffb400,#ff8800);color:#111" onclick="playCasino(50000)">🎲 50 000 ₽</button><button class="btn" style="background:linear-gradient(135deg,#ffb400,#ff8800);color:#111" onclick="playCasino(100000)">🎲 100 000 ₽</button><div id="casinoRes"></div><div class="ic2" style="display:block;background:#fff4d6;font-size:.85rem;margin-top:14px">40% проигрыш · 45% x2 · 15% x3</div>';return h}
function playCasino(b){if(S.money<b){toast('Мало денег','red');return}S.money-=b;var r=Math.random(),res=document.getElementById('casinoRes');if(r<0.4){res.innerHTML='<div class="ic2" style="display:block;background:#ffe5e5;text-align:center;padding:16px">😢 -'+fmt(b)+' ₽</div>';toast('😢 -'+fmt(b),'red')}else if(r<0.85){S.money+=b*2;res.innerHTML='<div class="ic2" style="display:block;background:#fff4d6;text-align:center;padding:16px">🎉 x2! +'+fmt(b)+' ₽</div>';toast('🎉 +'+fmt(b),'green')}else{S.money+=b*3;res.innerHTML='<div class="ic2" style="display:block;background:#f0fff4;text-align:center;padding:16px">💎 x3! +'+fmt(b*2)+' ₽</div>';toast('💎 ДЖЕКПОТ!','green')}save();upd()}

var RATS={count:5};
function rRats(){var h='<div class="ic2" style="display:block;text-align:center;background:linear-gradient(135deg,#4a1a1a,#8b0000);color:#fff;padding:20px"><div style="font-size:3rem">🐀</div><h2>КРЫСЫ</h2><p style="font-size:.85rem;opacity:.9">Найди крысу — потеряй!</p></div><div class="ic2">💰 <b>'+fmt(S.money)+' ₽</b></div><div style="background:#fff;border-radius:14px;padding:14px;margin-bottom:10px"><div style="font-weight:700;margin-bottom:10px">Крыс:</div><div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px"><button class="btn" style="background:'+(RATS.count===5?'#e74c3c':'#f5a623')+'" onclick="setRats(5)">5</button><button class="btn" style="background:'+(RATS.count===10?'#e74c3c':'#f5a623')+'" onclick="setRats(10)">10</button><button class="btn" style="background:'+(RATS.count===25?'#e74c3c':'#f5a623')+'" onclick="setRats(25)">25</button></div></div><input class="vin" id="ratsBet" type="number" placeholder="Ставка"><button class="btn gr" onclick="startRats()">▶️ НАЧАТЬ</button><div class="ic2" style="display:block;background:#fff4d6;font-size:.85rem;margin-top:14px">5=×2 · 10=×3 · 25=×5</div>';return h}
function setRats(n){RATS.count=n;toast('🐀 '+n,'green');openApp('rats')}
function startRats(){var b=parseInt(document.getElementById('ratsBet').value)||0;if(b<=0){toast('Введите ставку','red');return}if(S.money<b){toast('Мало денег','red');return}S.money-=b;save();upd();var mult=RATS.count===5?2:RATS.count===10?3:5;var pot=b;var tc=RATS.count*2;var field=[];for(var i=0;i<tc;i++)field.push(i<RATS.count?'rat':'safe');for(var i=field.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=field[i];field[i]=field[j];field[j]=t}field=field.slice(0,RATS.count);var op=0;var act=true;var t=document.getElementById('at'),bb=document.getElementById('ab');t.textContent='🐀 Крысы';function render(){var h='<div class="ic2">Ставка: <b>'+fmt(b)+'</b> · Макс: <b>'+fmt(b*mult)+'</b></div><div style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;max-width:400px;margin:14px auto">';for(var i=0;i<field.length;i++){h+='<div id="rc'+i+'" onclick="openRat('+i+')" style="aspect-ratio:1;background:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;cursor:pointer;user-select:none">❓</div>'}h+='</div><button class="btn rd" onclick="exitRats()">🚪 ВЫЙТИ</button><div id="ratsMsg" class="ic2" style="display:block;text-align:center;margin-top:12px">Выбирай!</div>';bb.innerHTML=h}
window.openRat=function(i){if(!act)return;var cell=document.getElementById('rc'+i);if(!cell||cell.dataset.done)return;cell.dataset.done='1';if(field[i]==='rat'){cell.textContent='🐀';cell.style.background='#ffebee';act=false;setTimeout(function(){document.getElementById('ratsMsg').innerHTML='<div style="color:#e74c3c;font-weight:800">😱 КРЫСА! -'+fmt(b)+'</div>';},300)}else{cell.textContent='💰';cell.style.background='#e8f5e9';op++;var cv=Math.round(pot*0.15);pot+=cv;document.getElementById('ratsMsg').innerHTML='<div style="color:#27ae60;font-weight:700">✅ Банк: '+fmt(pot)+'</div>';if(op>=RATS.count){act=false;S.money+=pot;save();upd();setTimeout(function(){document.getElementById('ratsMsg').innerHTML='<div style="color:#27ae60;font-weight:800">🎉 +'+fmt(pot)+'</div>';},300)}}}
window.exitRats=function(){if(act&&confirm('Забрать '+fmt(pot)+'?')){S.money+=pot;save();upd();toast('💰 Забрано','green')}openApp('rats')};render()}
</script><script>
var BB={grid:[],score:0,figs:[],selected:-1,progress:0};
function rBlock(){setTimeout(bbInit,50);return '<div style="background:linear-gradient(180deg,#1a3d7c,#0d1e40);min-height:100%;color:#fff;padding:14px;border-radius:14px"><div style="background:rgba(255,255,255,.12);border-radius:12px;padding:9px 12px;margin-bottom:10px;text-align:center;font-weight:800">🕐 Время игры: <span id="bbGameClock">'+tm()+'</span> · День '+S.day+' · ⚡ 2× скорость</div><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><div id="bbScoreBox" style="background:rgba(255,255,255,.15);padding:8px 16px;border-radius:20px;font-weight:800;font-size:1.1rem">🏆 0</div><div style="background:rgba(255,215,0,.2);padding:6px 12px;border-radius:16px;font-size:.8rem;color:#ffd966">Рекорд: '+(S.bbRecord||0)+'</div></div><div style="text-align:center;font-size:.85rem;margin-bottom:8px">Собирай ряды! За 10 000 очков → +1 000 ₽</div><div id="bbField" style="background:#0a1a3a;border:3px solid #2c5aa0;border-radius:14px;padding:6px;display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin:0 auto;max-width:300px"></div><div id="bbFigs" style="display:flex;justify-content:space-around;margin-top:16px;gap:8px"></div><button onclick="bbNewGame()" style="width:100%;padding:14px;border:none;border-radius:12px;font-size:1rem;font-weight:800;margin-top:14px;background:linear-gradient(135deg,#ffb400,#ff8800);color:#111;cursor:pointer">🔄 Новая игра</button><div id="bbMsg" style="text-align:center;margin-top:10px;font-weight:700;min-height:24px"></div></div>'}
function bbInit(){BB.grid=[];for(var i=0;i<25;i++)BB.grid.push(0);BB.figs=[];BB.selected=-1;bbGenFigs();bbRender()}
function bbGenFigs(){BB.figs=[];for(var i=0;i<3;i++){var t=Math.floor(Math.random()*5);var c=Math.floor(Math.random()*5)+1;var s;if(t===0)s=[[1,1]];else if(t===1)s=[[1],[1]];else if(t===2)s=[[1,1],[1,1]];else if(t===3)s=[[1,0],[1,1]];else s=[[1,1,1]];BB.figs.push({shape:s,color:c,done:false})}}
function bbColor(c){return['','#e74c3c','#f5a623','#27ae60','#9b59b6','#4a9eff'][c]||'#4a9eff'}
function bbRender(){var f=document.getElementById('bbField');if(!f)return;var h='';for(var i=0;i<25;i++){h+='<div style="aspect-ratio:1;background:'+(BB.grid[i]?bbColor(BB.grid[i]):'#162e52')+';border-radius:6px" onclick="bbPlace('+i+')"></div>'}f.innerHTML=h;var fg=document.getElementById('bbFigs');var fh='';BB.figs.forEach(function(fig,idx){if(fig.done)return;fh+='<div style="background:'+(BB.selected===idx?'rgba(255,215,0,.15)':'rgba(255,255,255,.1)')+';padding:10px;border-radius:12px;cursor:pointer;border:2px solid '+(BB.selected===idx?'#ffd966':'transparent')+'" onclick="bbSelect('+idx+')">';for(var r=0;r<fig.shape.length;r++){fh+='<div style="line-height:0">';for(var c=0;c<fig.shape[r].length;c++){if(fig.shape[r][c])fh+='<span style="display:inline-block;width:16px;height:16px;margin:1px;border-radius:4px;background:'+bbColor(fig.color)+'"></span>';else fh+='<span style="display:inline-block;width:16px;height:16px;margin:1px"></span>'}fh+='</div>'}fh+='</div>'});fg.innerHTML=fh;var sb=document.getElementById('bbScoreBox');if(sb)sb.textContent='🏆 '+BB.score}
function bbSelect(i){if(BB.figs[i]&&!BB.figs[i].done){BB.selected=i;bbRender()}}
function bbPlace(pos){if(BB.selected<0){document.getElementById('bbMsg').innerHTML='⚠️ Выбери фигуру!';return}var fig=BB.figs[BB.selected];if(!fig||fig.done)return;var row=Math.floor(pos/5),col=pos%5;var rows=fig.shape.length,cols=fig.shape[0].length;if(row+rows>5||col+cols>5){document.getElementById('bbMsg').innerHTML='⚠️ Не влезает!';return}for(var r=0;r<rows;r++)for(var c=0;c<cols;c++)if(fig.shape[r][c]&&BB.grid[(row+r)*5+(col+c)]){document.getElementById('bbMsg').innerHTML='⚠️ Занято!';return}for(var r=0;r<rows;r++)for(var c=0;c<cols;c++)if(fig.shape[r][c])BB.grid[(row+r)*5+(col+c)]=fig.color;BB.score+=10;fig.done=true;BB.selected=-1;var cl=0;for(var r=0;r<5;r++){var full=true;for(var c=0;c<5;c++)if(!BB.grid[r*5+c]){full=false;break}if(full){for(var c=0;c<5;c++)BB.grid[r*5+c]=0;cl++}}for(var c=0;c<5;c++){var full=true;for(var r=0;r<5;r++)if(!BB.grid[r*5+c]){full=false;break}if(full){for(var r=0;r<5;r++)BB.grid[r*5+c]=0;cl++}}if(cl>0){BB.score+=cl*50;document.getElementById('bbMsg').innerHTML='🎉 +'+(cl*50)+'!'}else document.getElementById('bbMsg').innerHTML='';if(BB.score>=BB.progress+10000){BB.progress=Math.floor(BB.score/10000)*10000;S.money+=1000;toast('🎁 +1000 ₽ за '+BB.progress+' очков!','green');upd()}if(BB.score>(S.bbRecord||0))S.bbRecord=BB.score;S.bbScore=BB.score;save();if(BB.figs.every(function(f){return f.done}))bbGenFigs();bbRender()}
