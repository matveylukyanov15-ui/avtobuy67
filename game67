function buildGrid(){var g=document.getElementById('grid');if(!g)return;var h='';ICONS.forEach(function(i){h+='<div class="a" onclick="'+(i.tiktok?'openTikTok()':'openApp(\''+i.app+'\')')+'"><div class="ic" style="background:'+i.bg+';color:'+(i.bg==='#f5f5f5'?'#333':'#fff')+'">'+i.emoji+'</div><div class="lb">'+i.name+'</div></div>'});g.innerHTML=h}

setInterval(function(){
if(!S.garage||S.garage.length===0)return;
var chance=0.15+((S.rating||5.0)-4.0)*0.1;
if(Math.random()>chance)return;
var names=['Алексей','Дмитрий','Сергей','Иван','Максим','Андрей','Николай','Олег','Владимир','Павел','Мария','Елена'];
var name=names[Math.floor(Math.random()*names.length)];
var car=S.garage[Math.floor(Math.random()*S.garage.length)];
var texts=['Привет! Увидел '+car.model+'. Ещё продаёшь?','Здравствуйте! Интересует '+car.model+'. Цена?','Хочу '+car.model+'. Заберу за '+fmt(car.sellPrice)+' ₽','Слушай, '+car.model+' ещё актуальна?','Привет! '+car.model+' в каком состоянии?','Торг возможен по '+car.model+'?','Куплю твою '+car.model+'. Когда встретимся?'];
var text=texts[Math.floor(Math.random()*texts.length)];
S.chats.push({id:'ch'+Date.now()+Math.random(),seller:name,carModel:car.model,messages:[{from:'them',text:text}]});
save();toast('💬 '+name+' написал!','green');
},5000);

window._activeApp='';window._lastGameTick=Date.now();setInterval(function(){var now=Date.now(),dt=Math.max(0,Math.min(5,(now-(window._lastGameTick||now))/1000));window._lastGameTick=now;var speed=window._activeApp==='block'?2:1;var add=dt*speed/60;S.time+=add;while(S.time>=24){S.time-=24;S.day++;checkDebt();if(S.meeting&&S.day>S.meeting.day)S.meeting=null;if(S.alarm&&S.alarmDay&&S.day>S.alarmDay){S.alarm=0;S.alarmDay=0;}}save();upd()},250);

if(!load()){refill();save()}
ensureNick();
if(!Array.isArray(S.cars)||S.cars.length<500)refill();
if(!S.filter||typeof S.filter!=='object')S.filter={priceMin:0,priceMax:999999999,yearMin:2000,yearMax:2025,city:'all',sort:'price-asc'};
else{
  S.filter.priceMin=0;
  S.filter.priceMax=999999999;
  S.filter.yearMin=2000;
  S.filter.yearMax=2025;
  S.filter.city='all';
  if(['price-asc','price-desc','year-asc','year-desc'].indexOf(S.filter.sort)<0)S.filter.sort='price-asc';
}
save();
buildGrid();
if(S.wallpaper)document.body.style.background='url('+S.wallpaper+') center/cover fixed';
upd();
setInterval(save,5000);
window.addEventListener('beforeunload',save);
document.addEventListener('visibilitychange',function(){if(document.hidden)save()});
</script>
