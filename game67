function callWorker(id){var c=null;for(var i=0;i<S.garage.length;i++)if(S.garage[i].id===id){c=S.garage[i];break}if(!c)return;ensureBreakdowns(c);var cost=workerCost(c);var old=document.getElementById('workerModal');if(old)old.remove();var d=document.createElement('div');d.id='workerModal';d.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:120';d.innerHTML='<div style="position:absolute;left:0;right:0;bottom:0;background:#fff;border-radius:24px 24px 0 0;padding:22px 18px 28px"><div style="text-align:center;font-size:3rem">👨‍🔧</div><h2 style="text-align:center;margin:4px 0 8px">Обслуживание и диагностика</h2><div style="text-align:center;color:#666;margin-bottom:16px">'+c.brand+' '+c.model+'</div><div class="ic2" style="display:block;background:#eaf6ff">Работник проверит машину и покажет, какие детали сломаны.<br><b>Стоимость работы: '+fmt(cost)+' ₽</b></div><button class="btn bl" onclick="confirmWorker(\''+c.id+'\')">👨‍🔧 Вызвать за '+fmt(cost)+' ₽</button><button class="btn gy" onclick="this.parentElement.parentElement.remove()">❌ Отказаться</button></div>';document.body.appendChild(d)}
function confirmWorker(id){var c=null;for(var i=0;i<S.garage.length;i++)if(S.garage[i].id===id){c=S.garage[i];break}if(!c)return;var cost=workerCost(c);if(S.money<cost){toast('💰 Не хватает денег','red');return}S.money-=cost;ensureBreakdowns(c);c.inspected=false;c.justBought=false;var d=document.getElementById('workerModal');if(d)d.remove();S.log.push({type:'service',text:'Диагностика '+c.model,amount:cost});save();upd();runInspection(id)}
function repairCar(id){var i=-1;for(var k=0;k<S.garage.length;k++)if(S.garage[k].id===id){i=k;break}if(i<0)return;var c=S.garage[i];if(c.restricted){toast('⛔ Запрещено','red');return}if(c.condition>=100){toast('✅ Идеал','green');return}if(S.money<c.repairCost){toast('Мало денег','red');return}S.money-=c.repairCost;var boost=Math.floor(15+Math.random()*20);c.condition=Math.min(100,c.condition+boost);c.sellPrice+=Math.round(c.repairCost*1.4);save();upd();toast('🔧 +'+boost+'%','green');openApp('garage')}

