if(S.debt>0){h+='<div class="ic2" style="display:block;background:#ffe5e5"><b>💳 Долг:</b> '+fmt(S.debt)+' ₽<br>Срок: день '+S.debtDay+'<br>Просрочка: '+(S.debtOverdue||0)+' дн (+5%/день)</div><input class="vin" id="payAmount" type="number" placeholder="Сумма"><button class="btn gr" onclick="payPartial()">💸 Частично</button><button class="btn rd" onclick="payCredit()">💸 Всё</button>'}
else{h+='<div class="ic2" style="display:block"><b>💳 Кредит</b><br>Ставка: <b>+20%</b>, срок 3 дня</div><input class="vin" id="creditAmount" type="number" placeholder="Сумма (мин 1000)"><button class="btn gr" onclick="takeCredit()">💳 Взять</button>'}
